  "description": "Secure Node.js/Express backend for controlling one inverter through ESP32 and MQTT.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:init": "node scripts/init-db.js",
